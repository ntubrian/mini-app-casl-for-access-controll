{
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "tsc --project apps/api/tsconfig.build.json"
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/api/src/dev.ts"
      },
      "configurations": {
        "development": {
          "command": "tsx apps/api/src/dev.ts"
        },
        "production": {
          "command": "node dist/apps/api/apps/api/src/dev.js"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
