{
  "name": "web",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "executor": "@nx/next:server",
      "options": {
        "root": "apps/web",
        "buildTarget": "web:build",
        "port": 3000,
        "dev": true
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "root": "apps/web",
        "outputPath": "dist/apps/web"
      }
    },
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "root": "apps/web",
        "buildTarget": "web:build",
        "dev": false
      }
    }
  }
}
