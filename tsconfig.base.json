{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@db": ["libs/db/src/index.ts"],
      "@db/*": ["libs/db/src/*"],
      "@policies": ["libs/policies/src/index.ts"],
      "@policies/*": ["libs/policies/src/*"]
    }
  }
}
